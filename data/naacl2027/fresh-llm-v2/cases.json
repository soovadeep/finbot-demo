      "id": "pol-prepaid",
      "kind": "policy",
      "question": "Are we allowed to add a surcharge when a customer pays with a prepaid card?",
      "records": [],
      "expected_facts": "No; debit and prepaid cards cannot be surcharged."
    },
    {
      "id": "pol-cap-pct",
      "kind": "policy",
      "question": "What's the highest surcharge percentage we can charge on credit cards?",
      "records": [],
      "expected_facts": "Capped at 3 percent (credit cards only)."
    },
    {
      "id": "pol-disclose",
      "kind": "policy",
      "question": "Do surcharges have to be disclosed to the customer, and when?",
      "records": [],
      "expected_facts": "Yes, before payment."
    },
    {
      "id": "pol-how-send",
      "kind": "policy",
      "question": "How do we send a surcharge amount with an authorization?",
      "records": [],
      "expected_facts": "Send surcharge_amount in minor units with the authorization request."
    },
